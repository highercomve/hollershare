<style>
  n1: border-color="#dedfd3 #292e28 #292e28 #292e28"
  n4: color=#292e28
  n5: color=#71756c
  preview: color-scheme=light
  n7: color=#292e28
  copy: background=#e6ebdf unset="outline"
  n9: color=#45624b
  saved: color=#71756c
  n13: color=#45624b
  @media (prefers-color-scheme: dark) {
    n1: border-color="#3b342c #f1eadf #f1eadf #f1eadf"
    n4: color=#f1eadf
    n5: color=#aaa194
    preview: color-scheme=dark
    n7: color=#f1eadf
    copy: background=#2b3327
    n9: color=#aec79f
    saved: color=#aaa194
    n13: color=#aec79f
  }
  @when (focus) {
    copy: outline=3,3,#a5b894
  }
  @when (focus) and (prefers-color-scheme: dark) {
    copy: outline=3,3,#9db58c
  }
</style>
<row class="n1" align="center" padding="12,0,12,0" border-width="1,0,0,0" row-gap="12" column-gap="12" unset="color font-size">
  <view grow="1" shrink="1" basis="0%" min-width="0">
    <view clip="true">
      <text class="n4" shrink="0" font-size="12" font-weight="600" font-family="DejaVu Sans, sans-serif" nowrap="true">{name}</text>
    </view>
    <text class="n5" shrink="0" margin="0,0,8,0" font-size="10" font-weight="400" font-family="DejaVu Sans, sans-serif" line-height="16">{detail}</text>
    <view id="preview" class="preview" max-height="180" margin="0,0,8,0" scroll="true" scroll-x="true">
      <text class="n7" shrink="0" font-size="14" font-weight="400" font-family="DejaVu Sans, sans-serif">{text}</text>
    </view>
    <view id="copy" class="copy" justify="center" align-self="flex-start" padding="10,12,10,12" radius="6" clickable="true">
      <text class="n9" shrink="0" font-size="11" font-weight="400" font-family="DejaVu Sans, sans-serif" text-align="center" nowrap="true">{copy-label}</text>
    </view>
    <row id="actions" wrap="wrap" margin="9,0,0,0" row-gap="8" column-gap="8" />
    <text id="saved" class="saved" shrink="0" font-size="10" font-weight="400" font-family="DejaVu Sans, sans-serif" line-height="16">{saved}</text>
  </view>
  <view unset="shrink">
    <text class="n13" shrink="0" font-size="11" font-weight="400" font-family="DejaVu Sans, sans-serif" text-align="right">{status}</text>
  </view>
</row>
