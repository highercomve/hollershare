<style>
  n1: border-color="#dedfd3 #292e28 #292e28 #292e28"
  n4: color=#292e28
  n5: color=#71756c
  n6: background=#dedfd3
  fill: background=#45624b
  n9: color=#45624b
  code: color=#71756c
  cancel: unset="outline"
  n12: color=#71756c
  @media (prefers-color-scheme: dark) {
    n1: border-color="#3b342c #f1eadf #f1eadf #f1eadf"
    n4: color=#f1eadf
    n5: color=#aaa194
    n6: background=#3b342c
    fill: background=#aec79f
    n9: color=#aec79f
    code: color=#aaa194
    n12: color=#aaa194
  }
  @when (focus) {
    cancel: outline=3,3,#a5b894
  }
  @when (focus) and (prefers-color-scheme: dark) {
    cancel: outline=3,3,#9db58c
  }
</style>
<row class="n1" align="center" padding="12,0,12,0" border-width="1,0,0,0" row-gap="12" column-gap="12" unset="color font-size">
  <view grow="1" shrink="1" basis="0%" min-width="0">
    <view clip="true">
      <text class="n4" shrink="0" font-size="12" font-weight="600" font-family="DejaVu Sans, sans-serif" nowrap="true">{name}</text>
    </view>
    <text class="n5" shrink="0" margin="0,0,9,0" font-size="10" font-weight="400" font-family="DejaVu Sans, sans-serif" line-height="16">{detail}</text>
    <view class="n6" height="4" margin="0" radius="2">
      <view id="fill" class="fill" width="0%" height="4" radius="2" />
    </view>
  </view>
  <view unset="shrink">
    <text class="n9" shrink="0" font-size="11" font-weight="400" font-family="DejaVu Sans, sans-serif" text-align="right">{status}</text>
    <text id="code" class="code" shrink="0" font-size="10" font-weight="400" font-family="DejaVu Sans, sans-serif" line-height="16" text-align="right">{code}</text>
    <view id="cancel" class="cancel" justify="center" align-self="flex-end" padding="4" radius="5" clickable="true">
      <text class="n12" shrink="0" font-size="11" font-weight="400" font-family="DejaVu Sans, sans-serif" text-align="center">Cancel</text>
    </view>
  </view>
</row>
